# Copy to `.env.local` and edit. Every value here is read in ONE place — `lib/config.ts`.
# An unrecognized backend value fails fast at startup with a readable message (CLAUDE.md §3);
# nothing silently defaults to a different backend than you asked for.

# ── AWS (generation only) ─────────────────────────────────────────────────────
# The app boots and serves the static registries with NONE of these set — verified, §1.3.
AWS_REGION=us-east-1
# Local development only. On Fargate use the task role and leave this unset.
AWS_PROFILE=

# ⚠️ Must be an INFERENCE PROFILE id, not a bare foundation-model id. §1.2 found that every
# ACTIVE Anthropic model in the verified account is INFERENCE_PROFILE-only: the bare
# `anthropic.claude-opus-5` id looks more correct and fails at invoke time.
DEFAULT_LLM_MODEL_ID=us.anthropic.claude-opus-5
# Optional — defaults to DEFAULT_LLM_MODEL_ID.
OUTLINE_MODEL_ID=

# ── Storage ───────────────────────────────────────────────────────────────────
# file   → JSON under DATA_DIR (v1 default; runs unchanged on Fargate with DATA_DIR on EFS)
# memory → in-process, lost on restart. A real option, used to prove the swap path (§6.3).
STORAGE_BACKEND=file
ASSET_BACKEND=local
AUTH_BACKEND=stub

DATA_DIR=./data
DEFAULT_USER_ID=local-user

# ── Limits ────────────────────────────────────────────────────────────────────
GENERATION_CONCURRENCY=2
MAX_ASSET_MB=5
MAX_SOURCE_TEXT_CHARS=20000

# Set to 1 to log every final prompt, making "no visual vocabulary in prompts" (§7) directly
# verifiable in debug logs rather than only in a unit test.
DEBUG_PROMPTS=0
