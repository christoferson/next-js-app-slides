    "verify:fixtures": "tsx scripts/make-fixtures.ts",
    "verify:pptx": "tsx scripts/verify-pptx.ts",
    "verify:pptx:assert": "tsx scripts/verify-pptx-assert.ts",
    "verify:pptx:probes": "tsx scripts/verify-pptx-probe2.ts && tsx scripts/verify-pptx-probe3.ts && tsx scripts/verify-pptx-probe4.ts && tsx scripts/verify-pptx-probe5.ts",
    "verify:pptx:letterbox": "tsx scripts/verify-pptx-letterbox-test.ts",
    "verify:pptx:thirdparty": "tsx scripts/verify-pptx-thirdparty.ts",
    "verify:pptx:all": "npm run verify:fixtures && npm run verify:pptx && npm run verify:pptx:assert && npm run verify:pptx:letterbox && npm run verify:pptx:thirdparty && npm run verify:pptx:probes",
    "verify:pptx:opentest": "tsx scripts/verify-pptx-opentest.ts",
    "verify:pptx:render": "tsx scripts/render-pptx.ts",
    "verify:fonts": "tsx scripts/verify-font-substitution.ts",
    "verify:bullets": "tsx scripts/verify-bullets3.ts",
    "verify:autofit": "tsx scripts/verify-autofit.ts",
    "verify:bedrock": "tsx scripts/verify-bedrock.ts",
    "verify:bedrock:models": "tsx scripts/verify-bedrock-models.ts",
    "verify:bedrock:errors": "tsx scripts/verify-bedrock-errors.ts",
    "verify:render:all": "npm run verify:pptx:opentest && npm run verify:pptx:render && npm run verify:fonts && npm run verify:bullets"
  },
